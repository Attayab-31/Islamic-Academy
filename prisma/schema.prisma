generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARENT
  TEACHER
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  name              String
  role              UserRole             @default(PARENT)
  emailVerified     DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  resetTokens       PasswordResetToken[]
  enrollments       Enrollment[]
  bookings          Booking[]
  teachers          Teacher[]
  bookingAuditEvents BookingAuditEvent[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Teacher {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  gender          String
  languages       String
  specializations String
  email           String?
  timezone        String   @default("UTC")
  zoomUserId      String?
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  bookings        Booking[]
  availability    AvailabilitySlot[]
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startHour Int
  startMin  Int      @default(0)
  duration  Int      @default(45)
  capacity  Int      @default(10)
  timezone  String   @default("UTC")
}

model Booking {
  id                String               @id @default(cuid())
  reference         String               @unique
  courseSlug        String
  programSlug       String?
  teacherId         String?
  teacher           Teacher?             @relation(fields: [teacherId], references: [id])
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  learnerName       String
  learnerAge        String
  level             String
  language          String
  teacherGender     String
  contactName       String
  contactEmail      String
  contactPhone      String?
  country           String
  timezone          String
  slotStart         DateTime
  slotEnd           DateTime
  zoomLink          String?
  status            String               @default("confirmed")
  whatsappOptIn     Boolean              @default(false)
  reminderSentAt    DateTime?
  createdAt         DateTime             @default(now())
  auditEvents       BookingAuditEvent[]
}

model BookingAuditEvent {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorUserId   String?
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType     String
  previousStatus String?
  newStatus     String?
  details       String?
  createdAt     DateTime @default(now())
}

model Enrollment {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id])
  fullName              String
  email                 String
  phone                 String?
  country               String
  courseSlug            String
  planName              String
  amount                Int
  currency              String
  paymentMethod         String   @default("bank_transfer")
  paymentReference      String?
  paymentStatus         String   @default("pending")
  accessStatus          String   @default("pending")
  activatedAt           DateTime?
  expiresAt             DateTime?
  teacherId             String?
  monthlyBlockStartAt   DateTime?
  monthlyBlockEndAt     DateTime?
  transferBank          String?
  transferAccountName   String?
  transferAccountNumber String?
  adminNotes            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  source    String?
  createdAt DateTime @default(now())
}
